// =============================================================================
// kqldb_mvoi — Eventhouse KQL database schema for Miami Valley Ops Intelligence
//
// Deployed by scripts/deploy_fabric.py with `.execute database script`.
// Every command is idempotent (create-merge / create-or-alter), so re-running
// is safe.
//
// Landing: Eventstream (custom endpoint -> Eventhouse destination,
// ProcessedIngestion — the API-automatable mode) writes the canonical event
// contract (docs/data-contracts.md) one row per event into `Events`, matching
// columns by name. `Events_json` is kept for DirectIngestion, which needs a
// UI-created data connection (see docs/deployment.md).
// =============================================================================

.create-merge table Events (
    schema_version: string,
    event_id: string,
    entity_key: string,
    source: string,
    entity_type: string,
    source_id: string,
    change_type: string,
    environment: string,
    run_mode: string,
    replay_session_id: string,
    observed_at: datetime,
    source_updated_at: datetime,
    first_seen_at: datetime,
    last_seen_at: datetime,
    start_time: datetime,
    end_time: datetime,
    ingested_at: datetime,
    latitude: real,
    longitude: real,
    geometry_geojson: string,
    route_name: string,
    corridor_id: string,
    direction: string,
    location: string,
    category: string,
    status: string,
    severity: string,
    severity_rank: int,
    is_road_closure: bool,
    title: string,
    description: string,
    attributes: dynamic,
    content_hash: string,
    raw: dynamic,
    // Added by Eventstream ProcessedIngestion
    EventProcessedUtcTime: datetime,
    PartitionId: long,
    EventEnqueuedUtcTime: datetime
) with (docstring = "Canonical MVOI events from Eventstream (live + replay)", folder = "Landing")

.create-or-alter table Events ingestion json mapping "Events_json"
```
